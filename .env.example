URL=http://localhost:3000
API_KEY=
LOG_LEVEL=DEBUG

# The logo's MQTT broker, as user `bridge` (MQTT_BRIDGE_PASSWORD in the logo's deploy/.env)
MQTT_HOST=mqtt.example.org
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=bridge
MQTT_PASSWORD=

# First DMX channel of the logo's 9 fixtures (1-based)
DMX_START_ADDRESS=1
